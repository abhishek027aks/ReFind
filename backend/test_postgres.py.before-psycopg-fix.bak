import importlib
import os
import uuid

import pytest
from fastapi.testclient import TestClient
from sqlalchemy import create_engine, text


POSTGRES_URL = os.environ.get("REFIND_DATABASE_URL", "")
RUN_POSTGRES = os.environ.get("REFIND_RUN_POSTGRES_TESTS") == "1"
pytestmark = pytest.mark.skipif(
    not RUN_POSTGRES or not POSTGRES_URL.startswith(("postgresql://", "postgresql+", "postgres://")),
    reason="Set REFIND_RUN_POSTGRES_TESTS=1 and REFIND_DATABASE_URL to run PostgreSQL tests",
)


def test_postgres_runtime_request_path_without_exposing_connection_url(monkeypatch):
    engine = create_engine(POSTGRES_URL, pool_pre_ping=True)
    with engine.connect() as connection:
        assert connection.execute(text("SELECT 1")).scalar_one() == 1

    monkeypatch.setenv("REFIND_DATABASE_URL", POSTGRES_URL)
    import main
    main = importlib.reload(main)
    main.initialise_database()
    email = f"pg-test-{uuid.uuid4().hex}@example.edu"
    with TestClient(main.app) as client:
        account = client.post(
            "/auth/register",
            json={"name": "Postgres Test", "email": email, "password": "password123"},
        )
        assert account.status_code == 201
        headers = {"Authorization": f"Bearer {account.json()['token']}"}
        report = client.post(
            "/reports",
            headers=headers,
            json={
                "kind": "lost",
                "name": "Postgres test item",
                "category": "Documents",
                "location": "Test location",
                "description": "Postgres runtime request path validation",
            },
        )
        assert report.status_code == 201
        assert client.get("/reports/my", headers=headers).status_code == 200
